<Window x:Class="LarkControl.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LarkControl.Windows"
        Title="{DynamicResource Main.Window.Title}" Width="1080" Height="900" MinWidth="820" MinHeight="640"
        ThemeMode="Light" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        AutomationProperties.Name="{DynamicResource Main.Window.Title}" AutomationProperties.AutomationId="HollylarkWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml" /></ResourceDictionary.MergedDictionaries>
            <local:ChoiceItemsConverter x:Key="ChoiceItemsConverter" />
            <DataTemplate x:Key="SettingTemplate">
                <DataTemplate.Resources>
                    <Style x:Key="SettingEditorLabelStyle" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="Content" Value="{Binding ChoiceLabel}" />
                        <Setter Property="Target" Value="{Binding ElementName=SettingChoice}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StepButtonsVisibility}" Value="Visible">
                                <Setter Property="Target" Value="{Binding ElementName=DecreaseGainButton}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SliderVisibility}" Value="Visible">
                                <Setter Property="Target" Value="{Binding ElementName=GainSlider}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataTemplate.Resources>
                <Grid Visibility="{Binding RowVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LabelColumnWidth}" /><ColumnDefinition Width="{Binding CurrentColumnWidth}" /><ColumnDefinition Width="*" MinWidth="{Binding EditorMinimumWidth}" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{Binding DisplayName}" Target="{Binding ElementName=CurrentSettingValue}" Visibility="{Binding CurrentFieldVisibility}" />
                    <TextBox x:Name="CurrentSettingValue" Grid.Column="1" Style="{StaticResource ReadoutStyle}" Text="{Binding ConfirmedValue, Mode=OneWay}" GotKeyboardFocus="OnReadoutFocus"
                             Visibility="{Binding CurrentFieldVisibility}" AutomationProperties.Name="{Binding CurrentName}" AutomationProperties.AutomationId="{Binding CurrentId}" />
                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource FocusableReadoutStyle}" Text="{Binding StaticValueText}" TextWrapping="Wrap" Margin="6,8" VerticalAlignment="Center" GotKeyboardFocus="OnReadoutFocus"
                               Visibility="{Binding StaticValueVisibility}" AutomationProperties.Name="{Binding StaticValueText}" AutomationProperties.AutomationId="{Binding StaticCurrentId}" />
                    <Label x:Name="NewSettingLabel" Style="{StaticResource SettingEditorLabelStyle}" Visibility="{Binding EditorLabelVisibility}" />
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <Label x:Name="InlineNewSettingLabel" Style="{StaticResource SettingEditorLabelStyle}" Visibility="{Binding InlineEditorLabelVisibility}" />
                        <local:GuardedSettingComboBox x:Name="SettingChoice" Style="{StaticResource {x:Type ComboBox}}" ItemsSource="{Binding Options, Converter={StaticResource ChoiceItemsConverter}}" MinWidth="150" Visibility="{Binding ChoiceVisibility}"
                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding ChoiceName}"
                                  AutomationProperties.AutomationId="{Binding ChoiceId}"
                                  local:UsageHints.Text="{Binding ChoiceHint}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding StepButtonsVisibility}">
                            <Button x:Name="DecreaseGainButton" Content="{DynamicResource Setting.Gain.DecreaseSymbol}" Tag="Decrease" IsEnabled="{Binding CanDecrease}" Click="OnStepGain" MinWidth="38"
                                    AutomationProperties.Name="{Binding DecreaseName}" AutomationProperties.AutomationId="{Binding DecreaseId}" />
                            <Button Content="{DynamicResource Setting.Gain.IncreaseSymbol}" Tag="Increase" IsEnabled="{Binding CanIncrease}" Click="OnStepGain" MinWidth="38"
                                    AutomationProperties.Name="{Binding IncreaseName}" AutomationProperties.AutomationId="{Binding IncreaseId}" />
                        </StackPanel>
                        <local:GuardedSettingSlider x:Name="GainSlider" Style="{DynamicResource {x:Type Slider}}" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                MinWidth="180" MinHeight="36" Margin="8,6" IsEnabled="{Binding CanEdit}" Visibility="{Binding SliderVisibility}"
                                Value="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="{DynamicResource Setting.Gain.SliderName}" AutomationProperties.AutomationId="{Binding SliderId}"
                                local:UsageHints.Text="{Binding ChoiceHint}" />
                        <TextBlock x:Name="DraftGainValue" Style="{StaticResource FocusableReadoutStyle}" Text="{Binding DraftValueText, Mode=OneWay}" GotKeyboardFocus="OnReadoutFocus"
                                 Visibility="{Binding DraftValueVisibility}" AutomationProperties.Name="{Binding DraftValueText}"
                                 AutomationProperties.AutomationId="{Binding DraftValueId}" />
                        <TextBox Style="{StaticResource ReadoutStyle}" Text="{Binding DraftValueText, Mode=OneWay}" GotKeyboardFocus="OnReadoutFocus"
                                 Visibility="{Binding DraftFieldVisibility}" AutomationProperties.Name="{Binding ChoiceName}"
                                 AutomationProperties.AutomationId="{Binding DraftFieldId}" />
                        <Button Content="{DynamicResource Setting.Apply}" IsEnabled="{Binding CanRequestApply}" Click="OnApplySetting" Visibility="{Binding ApplyVisibility}"
                                AutomationProperties.Name="{Binding ApplyName}" AutomationProperties.AutomationId="{Binding ApplyId}" />
                    </WrapPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TransmitterTemplate">
                <Button Content="{Binding ActionText}" IsEnabled="{Binding CanRequestMute}" Click="OnToggleMute" HorizontalAlignment="Left"
                        AutomationProperties.Name="{Binding ActionName}" AutomationProperties.AutomationId="{Binding ActionId}" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.ScanCommand}" Executed="OnScan" CanExecute="CanScan" />
        <CommandBinding Command="{x:Static local:MainWindow.RefreshCommand}" Executed="OnRefresh" CanExecute="CanRefresh" />
        <CommandBinding Command="{x:Static local:MainWindow.CancelOperationCommand}" Executed="OnCancelOperation" CanExecute="CanCancelOperation" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" IsTabStop="False" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None">
            <MenuItem Header="{DynamicResource Main.Menu.Program}" AutomationProperties.Name="{DynamicResource Main.Menu.ProgramName}">
                <MenuItem x:Name="SettingsMenuItem" Header="{DynamicResource Main.Menu.Settings}" Click="OnOpenSettings" AutomationProperties.Name="{DynamicResource Main.Menu.SettingsName}" AutomationProperties.AutomationId="SettingsMenuItem" />
                <MenuItem Header="{DynamicResource Main.Menu.AudioMeters}" Click="OnOpenAudioMeter" AutomationProperties.Name="{DynamicResource Main.Menu.AudioMetersName}" AutomationProperties.AutomationId="AudioMeterMenuItem" />
                <Separator />
                <MenuItem Header="{DynamicResource Main.Menu.Exit}" Click="OnExit" AutomationProperties.Name="{DynamicResource Main.Menu.ExitName}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Main.Menu.Help}" AutomationProperties.Name="{DynamicResource Main.Menu.HelpName}">
                <MenuItem x:Name="HelpMenuItem" Header="{DynamicResource Main.Menu.HelpWindow}" Click="OnOpenHelp" AutomationProperties.Name="{DynamicResource Main.Menu.HelpWindowName}" AutomationProperties.AutomationId="HelpMenuItem" />
                <MenuItem x:Name="InformationMenuItem" Header="{DynamicResource Main.Menu.Information}" Click="OnOpenInformation" AutomationProperties.Name="{DynamicResource Main.Menu.InformationName}" AutomationProperties.AutomationId="InformationMenuItem" />
                <MenuItem Header="{DynamicResource Main.Menu.Firmware}" Click="OnOpenFirmware" AutomationProperties.Name="{DynamicResource Main.Menu.FirmwareName}" AutomationProperties.AutomationId="FirmwareMenuItem" />
                <MenuItem Header="{DynamicResource Main.Menu.Manual}" Click="OnCopyManualAddress" AutomationProperties.Name="{DynamicResource Main.Menu.ManualName}" AutomationProperties.AutomationId="ManualMenuItem" />
            </MenuItem>
        </Menu>
        <TextBlock x:Name="ConnectionReadout" Grid.Row="1" Style="{StaticResource FocusableReadoutStyle}" Margin="18,12,18,6" GotKeyboardFocus="OnReadoutFocus" KeyboardNavigation.TabIndex="1"
                 Text="{DynamicResource Main.Usb.None}"
                 AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="ConnectionReadout" />
        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="12,6" KeyboardNavigation.TabIndex="2" local:UsageHints.Text="{DynamicResource Main.Sections.Name}" AutomationProperties.AutomationId="MainTabs">
            <TabItem x:Name="ControlTab" Header="{DynamicResource Main.Control.Tab}" AutomationProperties.Name="{DynamicResource Main.Control.Name}">
                <ScrollViewer x:Name="ControlsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False" Padding="12" KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel>
                        <TextBlock x:Name="ReadoutStatus" Style="{StaticResource FocusableReadoutStyle}" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Left" MaxWidth="{Binding ViewportWidth, ElementName=ControlsScrollViewer}" GotKeyboardFocus="OnReadoutFocus" AutomationProperties.AutomationId="ReadoutStatus" />
                        <TextBlock x:Name="ControlInstructions" Style="{StaticResource HintStyle}" Margin="0,0,0,8" HorizontalAlignment="Left" MaxWidth="{Binding ViewportWidth, ElementName=ControlsScrollViewer}" Text="{DynamicResource Main.Control.ManualHint}" />
                        <TextBlock x:Name="EmptyControlsReadout" Style="{StaticResource FocusableReadoutStyle}" FontWeight="SemiBold" Margin="0,0,0,8" GotKeyboardFocus="OnReadoutFocus" HorizontalAlignment="Left" MaxWidth="{Binding ViewportWidth, ElementName=ControlsScrollViewer}" Text="{DynamicResource Main.Control.AllHidden}" Visibility="Collapsed" AutomationProperties.AutomationId="EmptyControlsReadout" />
                        <Button Content="{DynamicResource Main.Menu.AudioMeters}" Click="OnOpenAudioMeter" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Main.Control.OpenMetersName}" AutomationProperties.AutomationId="OpenAudioMeterButton" />
                        <StackPanel x:Name="MicrophonesPanel">
                            <TextBlock Text="{DynamicResource Main.Control.Microphones}" Style="{StaticResource HeadingStyle}" />
                            <ListBox x:Name="TransmitterList" ItemsSource="{Binding TransmitterTargets}" DisplayMemberPath="Summary" Style="{StaticResource DeviceListStyle}" SelectionChanged="OnTransmitterSelected"
                                     MinHeight="60" MaxHeight="180" AutomationProperties.Name="{DynamicResource Main.Control.Microphones}" AutomationProperties.AutomationId="TransmitterList">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Visibility" Value="{Binding RowVisibility}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" />
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding ItemId}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <ContentControl Content="{Binding SelectedItem, ElementName=TransmitterList}" ContentTemplate="{StaticResource TransmitterTemplate}" Focusable="False" IsTabStop="False" />
                        </StackPanel>
                        <TextBlock x:Name="AudioHeading" Text="{DynamicResource Main.Control.Audio}" Style="{StaticResource HeadingStyle}" />
                        <StackPanel x:Name="AudioSettingsPanel" />
                        <TextBlock x:Name="DeviceHeading" Text="{DynamicResource Main.Control.Device}" Style="{StaticResource HeadingStyle}" />
                        <StackPanel x:Name="DeviceSettingsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ReceiverTab" Header="{DynamicResource Main.Receiver.Tab}" AutomationProperties.Name="{DynamicResource Main.Receiver.TabName}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="12" KeyboardNavigation.TabNavigation="Continue">
                    <GroupBox Header="{DynamicResource Main.Receiver.Group}" Padding="10" AutomationProperties.Name="{DynamicResource Main.Receiver.Group}">
                    <StackPanel>
                        <Label x:Name="ReceiverChoiceLabel" Content="{DynamicResource Main.Receiver.DiscoveredLabel}" Target="{Binding ElementName=ReceiverList}" AutomationProperties.Name="{DynamicResource Main.Receiver.DiscoveredName}" />
                        <ListBox x:Name="ReceiverList" ItemsSource="{Binding Receivers}" DisplayMemberPath="Name" Style="{StaticResource DeviceListStyle}" MinHeight="90" MaxHeight="120" ScrollViewer.HorizontalScrollBarVisibility="Auto" GotKeyboardFocus="OnReceiverListKeyboardFocus"
                                 SelectionChanged="OnReceiverSelected" AutomationProperties.Name="{DynamicResource Main.Receiver.DiscoveredName}" AutomationProperties.AutomationId="ReceiverList" AutomationProperties.LabeledBy="{Binding ElementName=ReceiverChoiceLabel}" />
                        <Button x:Name="SearchButton" Content="{DynamicResource Main.Receiver.Search}" Command="{x:Static local:MainWindow.ScanCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Main.Receiver.SearchName}" AutomationProperties.AutomationId="SearchButton" local:UsageHints.Text="{DynamicResource Main.Receiver.SearchHint}" />
                        <Label x:Name="ActiveReceiverLabel" Content="{DynamicResource Main.Usb.ActiveLabel}" Target="{Binding ElementName=ActiveReceiverReadout}" />
                        <TextBlock x:Name="ActiveReceiverReadout" Style="{StaticResource FocusableReadoutStyle}" TextWrapping="Wrap" GotKeyboardFocus="OnReadoutFocus"
                                   AutomationProperties.AutomationId="ActiveReceiverReadout" AutomationProperties.LabeledBy="{Binding ElementName=ActiveReceiverLabel}" />
                        <TextBlock x:Name="ReceiverSelectionHint" Style="{StaticResource HintStyle}" Text="{DynamicResource Main.Usb.MultipleHint}" />
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="12,2,12,12" KeyboardNavigation.TabIndex="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Label x:Name="ResultLabel" Content="{DynamicResource Main.Result.Label}" Target="{Binding ElementName=ResultReadout}" />
            <TextBlock x:Name="ResultReadout" Grid.Row="1" Style="{StaticResource FocusableReadoutStyle}" TextWrapping="Wrap" MinHeight="36" GotKeyboardFocus="OnReadoutFocus"
                     AutomationProperties.Name="{DynamicResource Main.Result.Name}" AutomationProperties.AutomationId="ResultReadout" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <Button x:Name="RefreshButton" Content="{DynamicResource Main.Refresh.Button}"
                    Command="{x:Static local:MainWindow.RefreshCommand}" AutomationProperties.Name="{DynamicResource Main.Refresh.Name}"
                    AutomationProperties.AutomationId="RefreshButton" local:UsageHints.Text="{DynamicResource Main.Usb.Retry}" />
            <Button x:Name="CancelOperationButton" Content="{DynamicResource Main.Command.Cancel}" Command="{x:Static local:MainWindow.CancelOperationCommand}" AutomationProperties.Name="{DynamicResource Main.Cancel.Name}" AutomationProperties.AutomationId="CancelOperationButton" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
