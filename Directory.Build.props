<Project>
  <PropertyGroup>
    <ProjectAvailableDrives>$([System.Environment]::GetLogicalDrives())</ProjectAvailableDrives>
    <ProjectMaterialsDrive Condition="'$(ProjectMaterialsDrive)' == '' and $(ProjectAvailableDrives.Contains('D:\'))">D:</ProjectMaterialsDrive>
    <ProjectMaterialsDrive Condition="'$(ProjectMaterialsDrive)' == ''">C:</ProjectMaterialsDrive>
    <ProjectSourceRoot>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileDirectory).'))</ProjectSourceRoot>
    <ProjectDirectoryName>$([System.IO.Path]::GetFileName('$(ProjectSourceRoot)'))</ProjectDirectoryName>
    <ProjectWorkspaceRoot>$(ProjectMaterialsDrive)\work\Workspace\$(ProjectDirectoryName)\</ProjectWorkspaceRoot>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <BaseOutputPath>$(ProjectWorkspaceRoot)Build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ProjectWorkspaceRoot)Build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
